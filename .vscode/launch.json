{
    // Run button for the whole hackathon folder. Pick an entry in the Run and
    // Debug dropdown, then press F5 (or the green arrow). Each entry builds
    // the app and loads it into the Connect IQ simulator via run-watch.sh.
    //
    // Garmin's own "monkeyc" launch type only works when the folder open in
    // VS Code is a single watch app, which this folder is not.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Run Gut Train",
            "command": "./run-watch.sh gut-train-app",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Run PacePilot",
            "command": "./run-watch.sh pacepilot-app",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Test Gut Train",
            "command": "./run-watch.sh gut-train-app test",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Test PacePilot",
            "command": "./run-watch.sh pacepilot-app test",
            "cwd": "${workspaceFolder}"
        }
    ]
}
